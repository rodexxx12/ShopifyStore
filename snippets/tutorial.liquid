{% assign num = 12434 %}
{% assign mod15 = num | modulo: 15 %}
{% assign mod3  = num | modulo: 3 %}
{% assign mod5  = num | modulo: 5 %}
{% assign mod2  = num | modulo: 2 %}

{% if mod15 == 0 %}
    <p>FizzBuzz - divisible by 3 and 5</p>
{% elsif mod3 == 0 %}
    <p>Fizz - divisible by 3</p>
{% elsif mod5 == 0 %}
    <p>Buzz - divisible by 5</p>
{% elsif mod2 == 0 %}
    <p>Even number</p>
{% else %}
    <p>Odd number, not divisible by 3 or 5</p>
{% endif %}

